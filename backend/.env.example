# ===================== core =====================
ENVIRONMENT=development                 # production on Render
SECRET_KEY=change-me-to-48-random-chars # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./dev.db         # Render injects postgres://... automatically
FRONTEND_URL=http://localhost:3000      # https://xotiictech.com
CORS_ORIGINS=                           # extra origins, comma-separated (e.g. https://www.xotiictech.com)
PROXY_SHARED_SECRET=                    # same random value as the frontend's PROXY_SHARED_SECRET
TRUSTED_PROXY_HOPS=1                    # for requests that bypass the Next proxy (e.g. Stripe webhooks)

# ===================== cookies / sessions =====================
COOKIE_SECURE=false                     # MUST be true in production
COOKIE_DOMAIN=                          # leave empty (host-only cookies on xotiictech.com)
USER_SESSION_DAYS=14
ADMIN_SESSION_HOURS=8

# ===================== admin (/xotiic) =====================
# Generate all three with:  python -m app.scripts.create_admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_IP_ALLOWLIST=                     # optional, comma-separated IPs

# ===================== stripe =====================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
CURRENCY=usd

# ===================== storage (Cloudflare R2 / Backblaze B2 / S3) =====================
STORAGE_BACKEND=local                   # s3 in production
S3_ENDPOINT_URL=                        # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=xotiictech-media
S3_PRIVATE_BUCKET=xotiictech-deliverables
S3_PUBLIC_BASE_URL=                     # https://media.xotiictech.com
LOCAL_STORAGE_DIR=./storage
MAX_MEDIA_MB=5120                       # images/videos, default 5 GB
MAX_UPLOAD_MB=51200                     # deliverables (zips, installers), default 50 GB

# ===================== email (Resend) =====================
RESEND_API_KEY=                         # empty = emails are printed to the log
EMAIL_FROM=XotiicTech <noreply@xotiictech.com>
ADMIN_NOTIFY_EMAIL=                     # where commission/contact/order alerts go

# ===================== discord auto-import =====================
# One token per bot, comma-separated. NEVER commit real tokens.
DISCORD_BOT_TOKENS=
DISCORD_SYNC_GUILD_COMMANDS=false       # also pull per-guild commands (bots in <=25 guilds)

# ===================== scheduler =====================
ENABLE_SCHEDULER=true
SYNC_ON_STARTUP=true
