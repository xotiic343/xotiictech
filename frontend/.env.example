# Frontend (xotiictech-web). Copy to .env.local for local dev. Never commit real values.

# --- main site ---
# Where Next.js reaches FastAPI (server-side only). On Render, BACKEND_HOSTPORT is set by the blueprint instead.
BACKEND_URL=http://localhost:8000
# Must match the API's PROXY_SHARED_SECRET.
PROXY_SHARED_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- /vendingx (vending machine proxy) ---
# Where Next.js proxies vendingx API requests to. Default: http://localhost:5000
VENDINGX_URL=http://localhost:5000

# --- /support (Discord login + tickets). Full guide: docs/SUPPORT.md ---
# Supabase: Connect > ORMs > Prisma. Keep the schema=support part on both.
SUPPORT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=support"
SUPPORT_DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=support"
# Any 32+ character random string.
AUTH_SECRET=
# Discord Developer Portal > OAuth2. Redirect: {site}/support/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Ticket X bot token (server-side only), your server ID, and staff role ID(s), comma-separated.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
STAFF_ROLE_ID=
# Same value as BOT_HEARTBEAT_SECRET in the bot's .env (16+ chars). Authenticates the bot's heartbeat,
# job polling and sync events.
BOT_HEARTBEAT_SECRET=
