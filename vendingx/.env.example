# ── Discord Bot ──────────────────────────────────────────
DISCORD_BOT_TOKEN=           # Bot token from Discord Developer Portal
DISCORD_CLIENT_ID=           # OAuth2 application client ID
DISCORD_CLIENT_SECRET=       # OAuth2 application client secret

# ── IDs ─────────────────────────────────────────────────
BOT_OWNER_ID=
PREMIUM_ROLE_ID=
MAIN_SERVER_ID=

# ── Web / API ───────────────────────────────────────────
API_PORT=5000
API_KEY=                     # Auto-generated if blank; used for admin endpoints
FRONTEND_URL=https://xotiictech.net
OAUTH_REDIRECT_URI=https://xotiictech.net/vendingx/auth/callback

# ── Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY=           # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=       # whsec_... from Stripe dashboard
STRIPE_PRICE_ID=             # price_... for the $3 one-time access
